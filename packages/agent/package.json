{
  "name": "@johto-ai/tcg-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Claude (ACP) conversational card-search backend for the TCG chat apps.",
  "license": "MIT",
  "files": [
