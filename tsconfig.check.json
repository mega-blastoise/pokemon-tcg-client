{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "emitDeclarationOnly": false,
    "declaration": false,
    "declarationMap": false,
    "allowImportingTsExtensions": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts", "packages/**/*.ts"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
